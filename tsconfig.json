{
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "public"],
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "module": "ESNext",
    "types": ["bun", "pdfkit"],
    "noEmit": true,
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "skipLibCheck": true
  }
}
